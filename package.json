{
  "name": "obsidian-x",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "icons": "node scripts/gen-icons.mjs",
    "setup": "node --env-file=.env.local scripts/setup.mjs",
    "smoke": "node --env-file=.env.local scripts/smoke.mjs",
    "test:w2": "node --test scripts/test-retitle-core.mjs && node scripts/test-reprocess-e2e.mjs && node --experimental-strip-types --no-warnings scripts/test-apply-proposal.mjs",
    "test:v41": "node --experimental-strip-types --no-warnings scripts/test-rank-mail.mjs && node --experimental-strip-types --no-warnings scripts/test-oauth-state.mjs",
    "test:v42": "node --experimental-strip-types --no-warnings scripts/test-letter.mjs && node --experimental-strip-types --no-warnings scripts/test-brief-window.mjs",
    "letter:sample": "node --experimental-strip-types --no-warnings scripts/test-letter.mjs --sample"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "mammoth": "^1.12.0",
    "next": "16.2.11",
    "node-ical": "^0.27.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^56.5.0"
  }
}
